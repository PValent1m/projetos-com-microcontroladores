int pinoMotor = 8;
int pinoBotao = 10;

void setup() {
  Serial.begin(115200);
  pinMode(pinoMotor, OUTPUT);
  pinMode(pinoBotao, INPUT_PULLUP);
  
}
int estado = 0;

void loop() {
  int botao = digitalRead(pinoBotao);
  switch(estado){
    case 0:
    digitalWrite(pinoMotor, HIGH);
      if(botao == 0){
        digitalWrite(pinoMotor, LOW);
        Serial.println("case 0");
        estado = 1;
        delay(100);
        
      }
      break;
    case 1:
      if(botao == 1){
        estado = 2;
        Serial.println("case 1");
        delay(100);
      }
      break;
    case 2:
     if(botao == 0){
        digitalWrite(pinoMotor, HIGH);
        Serial.println("case 2");
        estado = 3;
        delay(100);
      }
      break;
    case 3:
      if(botao == 1){
        estado = 0;
        Serial.println("case 3");
        delay(100);
      }
      break;
  }
}
